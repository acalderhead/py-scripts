{
  // Default interpreter for IntelliSense, linting, and debugging. Three managed
  // venvs exist (.venv311 / .venv312 / .venv313), one per Python minor version;
  // 3.13 is the default. Switch with the interpreter picker (Ctrl+Shift+P →
  // "Python: Select Interpreter") or the versioned debug configs in launch.json.
  // Recreate them all with:  .\setup-venvs.ps1
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv313/Scripts/python.exe",
  "python.analysis.extraPaths": ["${workspaceFolder}/scripts"],

  // Tests (optional) live in tests/ and import scripts via tests/conftest.py.
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],

  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": { "source.organizeImports": "explicit" }
  },

  // Keep files LF to match .gitattributes.
  "files.eol": "\n",

  // Status-bar "run via uv" button (VSCode Task Buttons extension:
  // spencerwmiles.vscode-task-buttons). Clicking it fires the default build
  // task, so it runs the active script through `uv run --exact` and honors that
  // script's PEP 723 pin exactly like Ctrl+Shift+B does.
  "VsCodeTaskButtons.tasks": [
    {
      "label": "$(play) uv run",
      "task": "uv run: current file (3.13)",
      "tooltip": "Run the active script via uv run --exact (honors its PEP 723 pin)"
    }
  ]
}
