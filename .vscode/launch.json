{
  "version": "0.2.0",
  "configurations": [
    {
      // PRIMARY (F5). Header-aware debugging: the preLaunchTask runs the open
      // script under debugpy via `uv run --with debugpy --script`, so the
      // PEP 723 header is honored and `[rich]` shows RichLogger exactly as a
      // real `uv run` would. VS Code attaches once the task prints DEBUGPY_READY.
      // (Mechanics: .vscode/tasks.json → "debug: uv run current file (3.13)" and
      // .vscode/debug/sitecustomize.py.)
      "name": "Debug current script — uv (header-aware)",
      "type": "debugpy",
      "request": "attach",
      "connect": { "host": "127.0.0.1", "port": 5678 },
      "preLaunchTask": "debug: uv run current file (3.13)",
      "justMyCode": true
    },
    {
      // Fallback: debug on the dev venv directly. The venvs carry plain
      // `scriptkit` (no [rich]), so logging uses the stdlib `[TAG]` fallback
      // regardless of the script's header. Simple and reliable; use it if the
      // uv attach above needs tweaking, or when the log style doesn't matter.
      "name": "Debug current script — venv 3.13 (stdlib)",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "python": "${workspaceFolder}/.venv313/Scripts/python.exe",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug current script — venv 3.12 (stdlib)",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "python": "${workspaceFolder}/.venv312/Scripts/python.exe",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug current script — venv 3.11 (stdlib)",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "python": "${workspaceFolder}/.venv311/Scripts/python.exe",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
