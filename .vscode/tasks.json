{
  "version": "2.0.0",
  "tasks": [
    {
      // Canonical way to run a script: uv reads the file's PEP 723 header and
      // builds an isolated env with exactly the pinned scriptkit version.
      // Run with Ctrl+Shift+B (default build task) on the open file.
      "label": "uv run: current file",
      "type": "shell",
      "command": "uv",
      "args": ["run", "${relativeFile}"],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "clear": true },
      "problemMatcher": []
    },
    {
      "label": "uv run: current file --help",
      "type": "shell",
      "command": "uv",
      "args": ["run", "${relativeFile}", "--help"],
      "problemMatcher": []
    }
  ]
}
